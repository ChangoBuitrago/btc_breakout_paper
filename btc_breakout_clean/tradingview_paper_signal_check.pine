//@version=5
// Paper bot mirror — 1D chart. Presets match LIVE_STRATEGY_PARAMS ($10k/sleeve, 2018+ rules).
//   BTCUSD  Dukascopy  lb15 buf125 cap225 hold5-10  bull_only
//   ETHUSDT Binance    lb10 buf150 cap225 hold10-13 bull_only
//   BNBUSDT Binance    lb15 buf125 cap225 hold6-10  bull_only
//   XAUUSD  Dukascopy  lb30 buf100 cap225 hold9-15  sma200_95
//   XAGUSD  Dukascopy  lb30 buf100 cap225 hold13-15 bull_only
//   XCUUSD  Dukascopy  lb15 buf100 cap225 hold4-5   bull_only
//   DOGEUSDT Binance    lb30 buf75  cap225 hold9-15 sma200_95
//   BRENT   Dukascopy  lb30 buf75  cap225 hold9-15 sma200_95
// Telegram: header date = SIG (closed bar). IN = next session open. OUT = dynamic hold @ close.
indicator("Paper breakout check", shorttitle="PaperSig", overlay=true, max_labels_count=500)

preset_in = input.string("Auto", "Sleeve preset ($10k paper)", options=["Auto", "Custom", "BTCUSD", "ETHUSDT", "BNBUSDT", "DOGEUSDT", "XAUUSD", "XAGUSD", "XCUUSD", "BRENT"])
show_prior_high = input.bool(true, "Plot prior-high level")
show_trade_bg = input.bool(true, "Shade bars in paper trade")
mark_days = input.int(120, "Date labels within last N days", minval=14)
skip_sat_entry = input.bool(true, "Skip Saturday entry (Dukascopy daily)")

lookback_c = input.int(15, "Lookback (Custom)", minval=1)
buffer_c = input.float(100.0, "Buffer bps (Custom)", step=1)
max_bb_c = input.float(225.0, "Max breakout bps, 0=off (Custom)", step=1)
hold_c = input.int(5, "Hold min days (Custom)", minval=1)
hold_max_c = input.int(10, "Hold max days (Custom)", minval=1)
hold_giveback_pct = input.float(3.0, "Momentum giveback % (dynamic exit)", minval=0.1, step=0.5) / 100.0
trend_c = input.string("bull_only", "Trend (Custom)", options=["all", "bull_only", "bear_only", "sma200", "sma200_95", "sma200_90", "sma100", "sma50", "sma50_slope_up", "sma200_slope_up"])

ticker_u = str.upper(syminfo.ticker)
auto_preset() =>
    str.contains(ticker_u, "DOGE") ? "DOGEUSDT" :
     str.contains(ticker_u, "ETH") ? "ETHUSDT" :
     str.contains(ticker_u, "BNB") ? "BNBUSDT" :
     str.contains(ticker_u, "BRENT") or str.contains(ticker_u, "UKOIL") or str.contains(ticker_u, "OIL") ? "BRENT" :
     str.contains(ticker_u, "XAU") or str.contains(ticker_u, "GOLD") ? "XAUUSD" :
     str.contains(ticker_u, "XAG") or str.contains(ticker_u, "SILVER") ? "XAGUSD" :
     str.contains(ticker_u, "XCU") or str.contains(ticker_u, "COPPER") or str.contains(ticker_u, "HG") ? "XCUUSD" :
     str.contains(ticker_u, "BTC") ? "BTCUSD" :
     "BTCUSD"

preset = preset_in == "Auto" ? auto_preset() : preset_in

lookback = preset == "Custom" ? lookback_c : preset == "ETHUSDT" ? 10 : (preset == "BTCUSD" or preset == "XCUUSD" or preset == "BNBUSDT" ? 15 : 30)
buffer_bps = preset == "Custom" ? buffer_c : preset == "ETHUSDT" ? 150.0 : (preset == "DOGEUSDT" or preset == "BRENT" ? 75.0 : (preset == "BTCUSD" or preset == "BNBUSDT" ? 125.0 : 100.0))
max_breakout_bps = preset == "Custom" ? max_bb_c : 225.0
hold_min = preset == "Custom" ? hold_c : preset == "ETHUSDT" ? 10 : preset == "BNBUSDT" ? 6 : preset == "XAUUSD" ? 9 : preset == "XAGUSD" ? 13 : preset == "XCUUSD" ? 4 : (preset == "DOGEUSDT" or preset == "BRENT" ? 9 : 5)
hold_max = preset == "Custom" ? hold_max_c : preset == "ETHUSDT" ? 13 : preset == "BNBUSDT" ? 10 : preset == "XAUUSD" ? 15 : preset == "XAGUSD" ? 15 : preset == "XCUUSD" ? 5 : (preset == "DOGEUSDT" or preset == "BRENT" ? 15 : 10)
dynamic_hold = hold_max > hold_min
trend_mode = preset == "Custom" ? trend_c : (preset == "XAUUSD" or preset == "DOGEUSDT" or preset == "BRENT" ? "sma200_95" : "bull_only")
data_note = preset == "ETHUSDT" or preset == "BNBUSDT" or preset == "DOGEUSDT" ? "Binance" : preset == "Custom" ? "custom" : "Dukascopy"

fmt_d() =>
    str.format("{0,date,yyyy-MM-dd}", time)

prior_high = ta.highest(close, lookback)[1]
breakout_bps = na(prior_high) or prior_high == 0.0 ? na : 10000.0 * (close / prior_high - 1.0)

raw_breakout = not na(prior_high) and close > prior_high * (1.0 + buffer_bps / 10000.0)
not_exhausted = max_breakout_bps <= 0 or (not na(breakout_bps) and breakout_bps <= max_breakout_bps)

sma50 = ta.sma(close, 50)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)
sma50_slope20 = sma50 - sma50[20]
sma200_slope20 = sma200 - sma200[20]

sma200_bull = close > sma200
bear = close < sma200

regime_on = switch trend_mode
    "bull_only" => sma200_bull
    "sma200" => sma200_bull
    "bear_only" => bear
    "sma200_95" => close > sma200 * 0.95
    "sma200_90" => close > sma200 * 0.90
    "sma100" => close > sma100
    "sma50" => close > sma50
    "sma50_slope_up" => (close > sma50) and (sma50_slope20 > 0)
    "sma200_slope_up" => sma200_slope20 > 0
    "all" => true
    => sma200_bull

signal = raw_breakout and not_exhausted and regime_on

var bool in_pos = false
var int hold_count = 0
var float entry_px = na
var float peak_close = na
var bool entry_armed = false
var string sig_date_txt = na

momentum_faded() =>
    close <= peak_close * (1.0 - hold_giveback_pct) or close < sma50 or sma50_slope20 < 0

was_in_pos = in_pos[1]
if signal and not in_pos
    entry_armed := true
    sig_date_txt := fmt_d()

today_can_enter = not skip_sat_entry or dayofweek(time) != dayofweek.saturday
entered = entry_armed and not in_pos and today_can_enter
exited = false

if entered
    in_pos := true
    hold_count := 1
    entry_px := open
    peak_close := close
    entry_armed := false
    sig_date_txt := na
else if in_pos
    hold_count += 1
    peak_close := math.max(peak_close, close)
    fade_out = dynamic_hold and hold_count >= hold_min and momentum_faded()
    max_out = dynamic_hold ? hold_count >= hold_max : hold_count >= hold_min
    if max_out or fade_out
        in_pos := false
        exited := true
        hold_count := 0
        entry_px := na
        peak_close := na

// SIG only on a new flat-to-signal transition (not while already long); allow exit+signal same bar
new_signal_mark = signal and not in_pos and (not was_in_pos or exited)
pending_mark = entry_armed and not in_pos and not entered

in_trade_bar = in_pos or exited
unreal_pct = in_pos and not na(entry_px) and entry_px != 0.0 ? 100.0 * (close / entry_px - 1.0) : na
in_label_window = time >= timenow - mark_days * 86400000

bgcolor(show_trade_bg and in_trade_bar ? color.new(color.teal, 88) : na, title="In trade")
plot(show_prior_high ? prior_high : na, "Prior high", color=color.new(color.orange, 35), linewidth=1, style=plot.style_stepline)

plotshape(new_signal_mark and in_label_window, title="Signal (close)", style=shape.circle, location=location.belowbar, size=size.tiny, color=color.new(color.gray, 0), text="SIG")
plotshape(pending_mark and in_label_window, title="Armed (next open)", style=shape.diamond, location=location.belowbar, size=size.tiny, color=color.new(color.yellow, 0), text="ARM")
plotshape(entered and in_label_window, title="Entry (open)", style=shape.triangleup, location=location.belowbar, size=size.small, color=color.new(color.teal, 0), text="IN")
plotshape(exited and in_label_window, title="Exit (close)", style=shape.triangledown, location=location.abovebar, size=size.small, color=color.new(color.red, 0), text="OUT")

if new_signal_mark and in_label_window
    label.new(bar_index, low, "SIG " + fmt_d(), style=label.style_label_up, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
if entered and in_label_window
    label.new(bar_index, low, "IN " + fmt_d(), style=label.style_label_up, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)
if exited and in_label_window
    label.new(bar_index, high, "OUT " + fmt_d(), style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

var label status = na
if barstate.islast
    label.delete(status)
    auto_note = preset_in == "Auto" ? " (Auto→" + preset + ")" : ""
    pending = entry_armed and not in_pos
    sig_txt = pending and not na(sig_date_txt) ? sig_date_txt : "—"
    hold_label = dynamic_hold ? str.tostring(hold_count) + "/" + str.tostring(hold_min) + "-" + str.tostring(hold_max) : str.tostring(hold_count) + "/" + str.tostring(hold_min)
    fade_note = in_pos and dynamic_hold and hold_count >= hold_min and momentum_faded() ? " fade→exit" : ""
    status_txt = pending ? "Pending SIG " + sig_txt + " → next open" : in_pos ? "LONG " + hold_label + " " + str.tostring(unreal_pct, "#.##") + "%" + fade_note : "Flat"
    hold_detail = dynamic_hold ? "hold" + str.tostring(hold_min) + "-" + str.tostring(hold_max) + " dyn" : "hold" + str.tostring(hold_min)
    detail = preset + auto_note + " $10k | " + data_note + " | lb" + str.tostring(lookback) + " buf" + str.tostring(buffer_bps, "#") + " " + hold_detail + " " + trend_mode
    detail += "\nbar " + fmt_d() + " | SIG date = Telegram closed bar"
    detail += "\nTV OHLC may differ from Dukascopy/Binance bot feed"
    status := label.new(bar_index, high, status_txt + "\n" + detail, style=label.style_label_lower_left, color=color.new(color.black, 15), textcolor=color.white, size=size.small)
